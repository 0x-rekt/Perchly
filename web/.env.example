# API origin. Leave empty when using the Vite development proxy or Docker nginx.
VITE_API_URL=

# Must match PERCHLY_OBSERVABILITY_API_KEY in the server environment.
VITE_OBSERVABILITY_API_KEY=replace-with-a-long-random-value

# GitHub App installation URL (for example: https://github.com/apps/perchly/installations/new)
VITE_GITHUB_APP_INSTALL_URL=https://github.com/apps/perchly/installations/new
