GITHUB_WEBHOOK_SECRET=replace-with-your-webhook-secret
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./your-github-app-private-key.pem
GITHUB_OAUTH_CLIENT_ID=your-github-app-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-github-app-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
WEB_APP_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-random-value-at-least-32-characters

# LLM and retrieval
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
RETRIEVAL_TOP_K=5

# Cloud PostgreSQL with pgvector
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Review policy
PERCHLY_AUTO_POST_THRESHOLD=0.90
PERCHLY_SECURITY_AUTO_POST_THRESHOLD=0.95
PERCHLY_MAX_AUTO_POST_FINDINGS=20

# Temporal (use temporal:7233 when running in Docker)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=perchly-reviews

# Runtime storage
PERCHLY_DATA_DIRECTORY=data

# Optional OpenTelemetry exporters
PERCHLY_OTEL_CONSOLE_EXPORT=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional: enable cloud PostgreSQL integration tests explicitly
RUN_POSTGRES_INTEGRATION=0
