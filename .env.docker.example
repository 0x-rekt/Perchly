# ==============================================================================
# Perchly Docker Configuration
# ==============================================================================

# GitHub App Integration
GITHUB_APP_ID=your-github-app-id
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Inside docker containers, this defaults to /app/perchly.2026-09-12.private-key.pem
GITHUB_PRIVATE_KEY_PATH=/app/perchly.2026-09-12.private-key.pem

# Gemini LLM & Embeddings
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
RETRIEVAL_TOP_K=5

# Cloud PostgreSQL Database with pgvector
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Orchestration (configured automatically in docker-compose)
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_TASK_QUEUE=perchly-reviews

# Policy & Thresholds
PERCHLY_AUTO_POST_THRESHOLD=0.90
PERCHLY_SECURITY_AUTO_POST_THRESHOLD=0.95
PERCHLY_MAX_AUTO_POST_FINDINGS=20
PERCHLY_DATA_DIRECTORY=/app/data

# Observability dashboard authentication and exporters
PERCHLY_OBSERVABILITY_API_KEY=replace-with-a-long-random-value
PERCHLY_OTEL_CONSOLE_EXPORT=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ngrok Tunnel (Required for custom reserved domain)
# Get your authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your-ngrok-authtoken

# Reserved ngrok hostname (or use an ephemeral URL by removing this value).
NGROK_DOMAIN=your-reserved-domain.ngrok-free.app
